
{
  "name": "hellmouth",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-21",
  "secrets": {
    "required": ["ADMIN_PASSWORD"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hellmouth-rolls"
    }
  ]
}
